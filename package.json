{
  "name": "dsh-mobile-plugin",
  "version": "0.2.0-alpha.1",
  "description": "Mobile access and a multi-goal Personal Agent for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "./dist/HLPlugin.js",
  "exports": {
    ".": "./dist/HLPlugin.js",
    "./client": "./dist/HLClient.js",
    "./personal": {
      "types": "./dist/types/personal/HLPersonal.d.ts",
      "import": "./dist/HLPersonal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets/HLBanner.webp",
    "cordis.patch.yml",
    "licenses",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GongShichen/dsh-mobile-plugin.git"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "packageManager": "pnpm@11.28.5",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/HLBuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:iroh": "node --import tsx --test tests/HLIrohRuntime.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "qa:personal": "node scripts/HLRunPersonalQA.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@napi-rs/keyring": "2.1.2",
    "@number0/iroh": "1.2.0",
    "google-auth-library": "^10.0.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@types/node": "^25.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.25.0",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
